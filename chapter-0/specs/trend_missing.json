{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Stacked area chart of the share of enrolled students without a result, split by reason, 2008 to 2026 (no tests in 2020). Shown for the state in param 'sel'; a dashed line shows Australia for comparison. The y-axis maximum is the param 'ymax'.",
  "width": "container",
  "height": 340,
  "padding": {
    "left": 4,
    "right": 12,
    "top": 6,
    "bottom": 4
  },
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "axis": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontWeight": 500,
      "titleFontSize": 11,
      "domain": false,
      "ticks": false,
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "labelFontSize": 11
    }
  },
  "params": [
    {
      "name": "sel",
      "value": "Australia"
    },
    {
      "name": "ymax",
      "value": 14
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "a": 2019,
            "b": 2021
          }
        ]
      },
      "mark": {
        "type": "rect",
        "color": "#e9e3d6",
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "a",
          "type": "quantitative",
          "scale": {
            "domain": [
              2007.5,
              2026.5
            ],
            "nice": false
          },
          "axis": {
            "title": null,
            "format": "d",
            "values": [
              2008,
              2010,
              2012,
              2014,
              2016,
              2018,
              2021,
              2023,
              2026
            ],
            "grid": false,
            "labelFontSize": 11
          }
        },
        "x2": {
          "field": "b"
        }
      }
    },
    {
      "data": {
        "url": "chapter-0/data/outcomes_trend.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.year <= 2019"
        },
        {
          "filter": "datum.state == sel"
        },
        {
          "fold": [
            "absent",
            "withdrawn",
            "nores"
          ],
          "as": [
            "reason",
            "pct"
          ]
        },
        {
          "calculate": "datum.reason == 'absent' ? 'Absent' : datum.reason == 'withdrawn' ? 'Withdrawn' : 'No result (excused or didn’t attempt)'",
          "as": "reason_label"
        },
        {
          "calculate": "datum.reason == 'absent' ? 0 : datum.reason == 'nores' ? 1 : 2",
          "as": "ord"
        },
        {
          "calculate": "datum.year < 2020 ? 'before 2020' : 'after 2020'",
          "as": "period"
        }
      ],
      "mark": {
        "type": "area",
        "opacity": 0.95,
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "domain": [
              2007.5,
              2026.5
            ],
            "nice": false
          },
          "axis": {
            "title": null,
            "format": "d",
            "values": [
              2008,
              2010,
              2012,
              2014,
              2016,
              2018,
              2021,
              2023,
              2026
            ],
            "grid": false,
            "labelFontSize": 11
          }
        },
        "y": {
          "field": "pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              14
            ],
            "nice": false,
            "domainMax": {
              "expr": "ymax"
            }
          },
          "axis": {
            "title": "% of enrolled students without a result",
            "grid": true,
            "tickCount": 5,
            "format": ".0f",
            "labelExpr": "datum.label + '%'"
          },
          "stack": "zero"
        },
        "color": {
          "field": "reason_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Absent",
              "No result (excused or didn’t attempt)",
              "Withdrawn"
            ],
            "range": [
              "#f0745a",
              "#a9c7d6",
              "#7b5ea7"
            ]
          },
          "legend": null
        },
        "order": {
          "field": "ord",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "reason_label",
            "title": "Reason"
          },
          {
            "field": "pct",
            "title": "% of enrolled students",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "chapter-0/data/outcomes_trend.csv",

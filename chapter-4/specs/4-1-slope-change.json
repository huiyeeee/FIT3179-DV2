{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Change in every domain and year level, 2023 → 2026",
    "subtitle": "Each line is one domain. Teal = moved the right way, orange = moved the wrong way."
  },
  "padding": {
    "left": 135,
    "right": 10,
    "top": 5,
    "bottom": 5
  },
  "params": [
    {
      "name": "metric",
      "value": "strongPlus"
    }
  ],
  "data": {
    "url": "data/progress_national.csv"
  },
  "transform": [
    {
      "filter": "datum.year == 2023 || datum.year == 2026"
    },
    {
      "calculate": "metric == 'needs' ? datum.needs : datum.strongPlus",
      "as": "v"
    },
    {
      "window": [
        {
          "op": "first_value",
          "field": "v",
          "as": "v0"
        },
        {
          "op": "last_value",
          "field": "v",
          "as": "v1"
        }
      ],
      "groupby": [
        "domain",
        "level"
      ],
      "sort": [
        {
          "field": "year"
        }
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "calculate": "datum.v1 - datum.v0",
      "as": "chg"
    },
    {
      "calculate": "(metric == 'needs' ? -datum.chg : datum.chg) >= 0 ? 'Improved' : 'Declined'",
      "as": "dir"
    },
    {
      "calculate": "datum.domain == 'Grammar and punctuation' ? 'Grammar' : datum.domain",
      "as": "dl"
    }
  ],
  "facet": {
    "column": {
      "field": "level",
      "type": "ordinal",
      "header": {
        "title": null,
        "labelFontSize": 13,
        "labelFontWeight": 600,
        "labelExpr": "'Year ' + datum.value"
      }
    }
  },
  "spacing": 28,
  "spec": {
    "width": 150,
    "height": 300,
    "encoding": {
      "x": {
        "field": "year",
        "type": "ordinal",
        "scale": {
          "type": "point",
          "padding": 0.9
        },
        "axis": {
          "title": null,
          "labelAngle": 0,
          "grid": false
        }
      },
      "y": {
        "field": "v",
        "type": "quantitative",
        "scale": {
          "zero": false
        },
        "axis": {
          "title": null,
          "labels": false,
          "ticks": false,
          "domain": false,
          "grid": false
        }
      },
      "color": {
        "field": "dir",
        "type": "nominal",
        "scale": {
          "domain": [
            "Improved",
            "Declined"
          ],
          "range": [
            "#1b7f79",
            "#d1572a"
          ]
        },
        "legend": {
          "title": null,
          "orient": "top",
          "direction": "horizontal"
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "line",
          "strokeWidth": 2.5
        },
        "encoding": {
          "detail": {
            "field": "domain"
          },
          "tooltip": [
            {
              "field": "domain",
              "title": "Domain"
            },
            {
              "field": "v0",
              "title": "2023 (%)",
              "format": ".1f"
            },
            {
              "field": "v1",
              "title": "2026 (%)",
              "format": ".1f"
            },
            {
              "field": "chg",
              "title": "Change (pts)",
              "format": "+.1f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "circle",
          "size": 55,
          "opacity": 1
        }
      },
      {
        "transform": [
          {
            "filter": "datum.year == 2023 && datum.level == 3"
          },
          {
            "calculate": "datum.dl + '  ' + format(datum.v0,'.1f')",
            "as": "t"
          }
        ],
        "mark": {
          "type": "text",
          "align": "right",
          "dx": -9,
          "fontSize": 11,
          "fontWeight": 600
        },
        "encoding": {
          "text": {
            "field": "t"
          },
          "color": {
            "value": "#1f2a37"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.year == 2023 && datum.level != 3"
          },
          {
            "calculate": "format(datum.v0,'.1f')",
            "as": "t"
          }
        ],
        "mark": {
          "type": "text",
          "align": "right",
          "dx": -8,
          "fontSize": 10.5,
          "dy": 0
        },
        "encoding": {
          "text": {
            "field": "t"
          },
          "color": {
            "value": "#6b7280"
          },
          "x": {
            "field": "year",
            "type": "ordinal"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.year == 2026"
          },
          {
            "calculate": "format(datum.v1,'.1f')",
            "as": "t"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "dx": 8,
          "fontSize": 10.5
        },
        "encoding": {
          "text": {
            "field": "t"
          },
          "color": {
            "value": "#6b7280"
          }
        }
      }
    ]
  },
  "config": {
    "font": "system-ui, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#374151",
      "titleColor": "#6b7280",
      "domainColor": "#cbd5e1",
      "gridColor": "#e5e7eb",
      "tickColor": "#cbd5e1"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#6b7280"
    },
    "title": {
      "fontSize": 13,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#1f2a37",
      "subtitleColor": "#6b7280",
      "subtitleFontSize": 12
    }
  }
}
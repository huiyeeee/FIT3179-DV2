{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "What moved the national average?",
    "subtitle": "Each step is a domain’s contribution to the change in the average share at “Strong or above”."
  },
  "width": 520,
  "height": 300,
  "data": {
    "url": "data/progress_waterfall.csv"
  },
  "transform": [
    {
      "calculate": "datum.end - datum.start",
      "as": "delta"
    },
    {
      "calculate": "datum.kind == 'total' ? 'Overall' : (datum.delta >= 0 ? 'Lifted the average' : 'Pulled it down')",
      "as": "role"
    },
    {
      "calculate": "(datum.delta >= 0 ? '+' : '−') + format(abs(datum.delta),'.2f')",
      "as": "lab"
    },
    {
      "calculate": "min(datum.start, datum.end)",
      "as": "lo"
    }
  ],
  "encoding": {
    "x": {
      "field": "step",
      "type": "nominal",
      "sort": {
        "field": "order"
      },
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelLimit": 90,
        "labelPadding": 6,
        "ticks": false,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#1f2a37",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "datum": 0,
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "size": 46,
        "cornerRadius": 2
      },
      "encoding": {
        "y": {
          "field": "start",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.85,
              0.15
            ]
          },
          "axis": {
            "title": "Change since 2023 (percentage points)",
            "grid": true,
            "format": "+.1f"
          }
        },
        "y2": {
          "field": "end"
        },
        "color": {
          "field": "role",
          "type": "nominal",
          "scale": {
            "domain": [
              "Lifted the average",
              "Pulled it down",
              "Overall"
            ],
            "range": [
              "#1b7f79",
              "#d1572a",
              "#1f2a37"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "step",
            "title": "Step"
          },
          {
            "field": "delta",
            "title": "Contribution (pts)",
            "format": "+.2f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "dy": 14,
        "baseline": "top"
      },
      "encoding": {
        "y": {
          "field": "lo",
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        },
        "color": {
          "value": "#1f2a37"
        }
      }
    }
  ],
  "config": {
    "font": "system-ui, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#374151",
      "titleColor": "#6b7280",
      "domainColor": "#cbd5e1",
      "gridColor": "#e5e7eb",
      "tickColor": "#cbd5e1"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#6b7280"
    },
    "title": {
      "fontSize": 13,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#1f2a37",
      "subtitleColor": "#6b7280",
      "subtitleFontSize": 12
    }
  }
}
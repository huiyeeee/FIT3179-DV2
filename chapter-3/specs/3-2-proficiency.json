{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Share of students at each proficiency level",
    "subtitle": "Bars to the right of the centre line have reached the expected standard (Strong or Exceeding)."
  },
  "width": 560,
  "height": 408,
  "params": [
    {
      "name": "level",
      "value": 9
    },
    {
      "name": "domain",
      "value": "Numeracy"
    }
  ],
  "data": {
    "url": "data/equity_national.csv"
  },
  "transform": [
    {
      "filter": "datum.year == 2026 && datum.level == level && datum.domain == domain && (datum.attr == 'Parental education' || datum.attr == 'Parental occupation')"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "group": "#Parental education",
            "title": "PARENTAL EDUCATION"
          },
          {
            "group": "#Parental occupation",
            "title": "PARENTAL OCCUPATION"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#6b7280",
        "dx": 2
      },
      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": null,
          "scale": {
            "domain": [
              "#Parental education",
              "Bachelor degree or above",
              "Diploma",
              "Certificate (trade / TAFE)",
              "Year 12",
              "Year 11 or below",
              "#Parental occupation",
              "Senior managers & professionals",
              "Other managers & associate professionals",
              "Skilled trades, clerical & sales",
              "Unskilled manual, office & sales",
              "Not in paid work (12 months)"
            ],
            "padding": 0.25
          },
          "axis": {
            "title": null,
            "domain": false,
            "ticks": false,
            "labelLimit": 240,
            "labelExpr": "substring(datum.label,0,1)=='#' ? '' : datum.label"
          }
        },
        "x": {
          "datum": -78,
          "type": "quantitative"
        },
        "text": {
          "field": "title"
        }
      }
    },
    {
      "transform": [
        {
          "fold": [
            "needs",
            "developing",
            "strong",
            "exceeding"
          ],
          "as": [
            "key",
            "pct"
          ]
        },
        {
          "calculate": "indexof(['needs','developing','strong','exceeding'], datum.key)",
          "as": "idx"
        },
        {
          "calculate": "['Needs additional support','Developing','Strong','Exceeding'][datum.idx]",
          "as": "levelName"
        },
        {
          "calculate": "datum.idx < 2 ? -datum.pct : datum.pct",
          "as": "signed"
        },
        {
          "calculate": "datum.idx == 0 ? 2 : (datum.idx == 1 ? 1 : (datum.idx == 2 ? 3 : 4))",
          "as": "stackOrder"
        }
      ],
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.78
        },
        "stroke": "white",
        "strokeWidth": 0.6
      },
      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": null,
          "scale": {
            "domain": [
              "#Parental education",
              "Bachelor degree or above",
              "Diploma",
              "Certificate (trade / TAFE)",
              "Year 12",
              "Year 11 or below",
              "#Parental occupation",
              "Senior managers & professionals",
              "Other managers & associate professionals",
              "Skilled trades, clerical & sales",
              "Unskilled manual, office & sales",
              "Not in paid work (12 months)"
            ],
            "padding": 0.25
          },
          "axis": {
            "title": null,
            "domain": false,
            "ticks": false,
            "labelLimit": 240,
            "labelExpr": "substring(datum.label,0,1)=='#' ? '' : datum.label"
          }
        },
        "x": {
          "field": "signed",
          "type": "quantitative",
          "scale": {
            "domain": [
              -78,
              118
            ],
            "nice": false
          },
          "axis": {
            "title": "Percentage of students",
            "values": [
              -75,
              -50,
              -25,
              0,
              25,
              50,
              75,
              100
            ],
            "labelExpr": "abs(datum.value) + '%'",
            "grid": true
          }
        },
        "color": {
          "field": "levelName",
          "type": "nominal",
          "scale": {
            "domain": [
              "Needs additional support",
              "Developing",
              "Strong",
              "Exceeding"
            ],
            "range": [
              "#b23a1e",
              "#f2b08a",
              "#7cc3bb",
              "#0f6d68"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal"
          }
        },
        "order": {
          "field": "stackOrder",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "levelName",
            "title": "Level"
          },
          {
            "field": "pct",
            "title": "Students (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#1f2a37",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "calculate": "format(datum.strongPlus,'.0f') + '%'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#1f2a37"
      },
      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": null,
          "scale": {
            "domain": [
              "#Parental education",
              "Bachelor degree or above",
              "Diploma",
              "Certificate (trade / TAFE)",
              "Year 12",
              "Year 11 or below",
              "#Parental occupation",
              "Senior managers & professionals",
              "Other managers & associate professionals",
              "Skilled trades, clerical & sales",
              "Unskilled manual, office & sales",
              "Not in paid work (12 months)"
            ],
            "padding": 0.25
          },
          "axis": {
            "title": null,
            "domain": false,
            "ticks": false,
            "labelLimit": 240,
            "labelExpr": "substring(datum.label,0,1)=='#' ? '' : datum.label"
          }
        },
        "x": {
          "datum": 118,
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        }
      }
    }
  ],
  "config": {
    "font": "system-ui, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#374151",
      "titleColor": "#6b7280",
      "domainColor": "#cbd5e1",
      "gridColor": "#e5e7eb",
      "tickColor": "#cbd5e1"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#6b7280"
    },
    "title": {
      "fontSize": 13,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#1f2a37",
      "subtitleColor": "#6b7280",
      "subtitleFontSize": 12
    }
  }
}
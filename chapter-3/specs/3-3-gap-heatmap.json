{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Gap in students reaching “Strong or above” (percentage points)",
    "subtitle": "Darker = wider gap. The outlined cell is the widest gap for this comparison."
  },
  "width": 440,
  "height": 230,
  "params": [
    {
      "name": "measure",
      "value": "Indigenous status"
    }
  ],
  "data": {
    "url": "data/equity_gaps.csv"
  },
  "transform": [
    {
      "filter": "datum.year == 2026 && datum.measure == measure"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "gap",
          "as": "maxGap"
        }
      ]
    },
    {
      "calculate": "'Year ' + datum.level",
      "as": "yl"
    }
  ],
  "encoding": {
    "x": {
      "field": "yl",
      "type": "ordinal",
      "sort": [
        "Year 3",
        "Year 5",
        "Year 7",
        "Year 9"
      ],
      "axis": {
        "title": null,
        "orient": "top",
        "labelAngle": 0,
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "domain",
      "type": "nominal",
      "sort": [
        "Reading",
        "Writing",
        "Spelling",
        "Grammar and punctuation",
        "Numeracy"
      ],
      "axis": {
        "title": null,
        "domain": false,
        "ticks": false,
        "labelLimit": 160
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "gap",
          "type": "quantitative",
          "scale": {
            "scheme": "oranges",
            "domain": [
              20,
              56
            ]
          },
          "legend": {
            "title": "Gap (pts)",
            "orient": "right",
            "gradientLength": 150
          }
        },
        "tooltip": [
          {
            "field": "domain",
            "title": "Domain"
          },
          {
            "field": "yl",
            "title": "Year level"
          },
          {
            "field": "advantaged",
            "title": "Advantaged group (%)"
          },
          {
            "field": "disadvantaged",
            "title": "Disadvantaged group (%)"
          },
          {
            "field": "gap",
            "title": "Gap (pts)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.gap == datum.maxGap"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": null,
        "stroke": "#1f2a37",
        "strokeWidth": 3
      },
      "encoding": {}
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "gap",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "condition": {
            "test": "datum.gap > 42",
            "value": "white"
          },
          "value": "#1f2a37"
        }
      }
    }
  ],
  "config": {
    "font": "system-ui, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#374151",
      "titleColor": "#6b7280",
      "domainColor": "#cbd5e1",
      "gridColor": "#e5e7eb",
      "tickColor": "#cbd5e1"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#6b7280"
    },
    "title": {
      "fontSize": 13,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#1f2a37",
      "subtitleColor": "#6b7280",
      "subtitleFontSize": 12
    }
  }
}
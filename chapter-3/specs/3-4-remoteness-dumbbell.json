{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Share of students at “Strong or above”, by remoteness",
    "subtitle": "Dot size shows how many students are in each group."
  },
  "width": 520,
  "height": 270,
  "params": [
    {
      "name": "level",
      "value": 9
    },
    {
      "name": "domain",
      "value": "Numeracy"
    }
  ],
  "data": {
    "url": "data/equity_remoteness.csv"
  },
  "transform": [
    {
      "filter": "datum.year == 2026 && datum.level == level && datum.domain == domain && isValid(datum.strongPlus)"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#cbd5e1"
      },
      "encoding": {
        "y": {
          "field": "remoteness",
          "type": "ordinal",
          "sort": [
            "Major cities",
            "Inner regional",
            "Outer regional",
            "Remote",
            "Very remote"
          ],
          "axis": {
            "title": null,
            "domain": false,
            "ticks": false,
            "labelFontSize": 13
          }
        },
        "x": {
          "aggregate": "min",
          "field": "strongPlus",
          "type": "quantitative"
        },
        "x2": {
          "aggregate": "max",
          "field": "strongPlus"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "opacity": 1,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "remoteness",
          "type": "ordinal",
          "sort": [
            "Major cities",
            "Inner regional",
            "Outer regional",
            "Remote",
            "Very remote"
          ],
          "axis": {
            "title": null,
            "domain": false,
            "ticks": false,
            "labelFontSize": 13
          }
        },
        "x": {
          "field": "strongPlus",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": "Students at Strong or above (%)",
            "grid": true,
            "format": "d"
          }
        },
        "color": {
          "field": "status",
          "type": "nominal",
          "scale": {
            "domain": [
              "Indigenous",
              "Non-Indigenous"
            ],
            "range": [
              "#d1572a",
              "#1f5f8b"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal"
          }
        },
        "size": {
          "field": "enrolled",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "range": [
              90,
              900
            ]
          },
          "legend": {
            "title": "Students",
            "orient": "top",
            "direction": "horizontal",
            "format": ","
          }
        },
        "tooltip": [
          {
            "field": "remoteness",
            "title": "Area"
          },
          {
            "field": "status",
            "title": "Group"
          },
          {
            "field": "strongPlus",
            "title": "Strong or above (%)",
            "format": ".1f"
          },
          {
            "field": "enrolled",
            "title": "Students",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.status == 'Indigenous'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -14,
        "fontWeight": 600,
        "fontSize": 12,
        "color": "#d1572a"
      },
      "encoding": {
        "y": {
          "field": "remoteness",
          "type": "ordinal",
          "sort": [
            "Major cities",
            "Inner regional",
            "Outer regional",
            "Remote",
            "Very remote"
          ],
          "axis": {
            "title": null,
            "domain": false,
            "ticks": false,
            "labelFontSize": 13
          }
        },
        "x": {
          "field": "strongPlus",
          "type": "quantitative"
        },
        "text": {
          "field": "strongPlus",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.status == 'Non-Indigenous'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "fontWeight": 600,
        "fontSize": 12,
        "color": "#1f5f8b"
      },
      "encoding": {
        "y": {
          "field": "remoteness",
          "type": "ordinal",
          "sort": [
            "Major cities",
            "Inner regional",
            "Outer regional",
            "Remote",
            "Very remote"
          ],
          "axis": {
            "title": null,
            "domain": false,
            "ticks": false,
            "labelFontSize": 13
          }
        },
        "x": {
          "field": "strongPlus",
          "type": "quantitative"
        },
        "text": {
          "field": "strongPlus",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
  ],
  "config": {
    "font": "system-ui, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#374151",
      "titleColor": "#6b7280",
      "domainColor": "#cbd5e1",
      "gridColor": "#e5e7eb",
      "tickColor": "#cbd5e1"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#6b7280"
    },
    "title": {
      "fontSize": 13,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#1f2a37",
      "subtitleColor": "#6b7280",
      "subtitleFontSize": 12
    }
  }
}
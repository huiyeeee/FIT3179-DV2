{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart. For each background factor, the share of students meeting expectations in the lower-scoring group (coral) and the higher-scoring group (teal), 2026, sorted by the size of the gap. Optional grey dots show the groups in between.",
  "width": "container",
  "height": 372,
  "padding": {
    "left": 4,
    "right": 8,
    "top": 34,
    "bottom": 4
  },
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "axis": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontWeight": 500,
      "titleFontSize": 11,
      "domain": false,
      "ticks": false,
      "gridColor": "#eee8dc"
    }
  },
  "params": [
    {
      "name": "groups",
      "value": false
    }
  ],
  "layer": [
    {
      "data": {
        "url": "chapter-3/data/factors.csv",
        "format": {
          "type": "csv",
          "parse": {
            "so_low": "number",
            "so_high": "number",
            "gap": "number",
            "gap_2023": "number",
            "share_low": "number",
            "share_high": "number",
            "rank": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "indexof([\"area\", \"edu\", \"job\", \"ind\", \"lang\", \"sex\"], datum.factor)",
          "as": "row"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 7,
        "strokeCap": "round",
        "color": "#d5dbe5"
      },
      "encoding": {
        "x": {
          "field": "so_low",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "nice": false
          },
          "axis": {
            "title": "Students meeting expectations (%)",
            "grid": true,
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "labelExpr": "datum.value + '%'"
          }
        },
        "x2": {
          "field": "so_high"
        },
        "y": {
          "field": "row",
          "scale": {
            "domain": [
              -0.5,
              5.5
            ],
            "reverse": true,
            "nice": false
          },
          "type": "quantitative",
          "axis": {
            "title": null,
            "values": [
              0,
              1,
              2,
              3,
              4,
              5
            ],
            "grid": false,
            "labelFontSize": 12,
            "labelFontWeight": 600,
            "labelColor": "#14213d",
            "labelPadding": 8,
            "labelLimit": 130,
            "labelExpr": "[\"Where they live\", \"Parents’ education\", \"Parents’ job\", \"Indigenous status\", \"Language at home\", \"Gender\"][datum.value]"
          }
        }
      }
    },
    {
      "data": {
        "url": "chapter-3/data/groups_all.csv",
        "format": {
          "type": "csv",
          "parse": {
            "so": "number",
            "share": "number",
            "order": "number"
          }
        }
      },
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "order",
              "as": "omax"
            }
          ],
          "groupby": [
            "factor"
          ]
        },
        {
          "filter": "groups && datum.order > 0 && datum.order < datum.omax"
        },
        {
          "calculate": "indexof([\"area\", \"edu\", \"job\", \"ind\", \"lang\", \"sex\"], datum.factor)",
          "as": "row"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 70,
        "color": "#8a96b0",
        "opacity": 0.9,
        "stroke": "#fff",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "so",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "nice": false
          }
        },
        "y": {
          "field": "row",
          "scale": {
            "domain": [
              -0.5,
              5.5
            ],
            "reverse": true,
            "nice": false
          },
          "type": "quantitative",
          "axis": {
            "title": null,
            "values": [
              0,
              1,
              2,
              3,
              4,
              5
            ],
            "grid": false,
            "labelFontSize": 12,
            "labelFontWeight": 600,
            "labelColor": "#14213d",
            "labelPadding": 8,
            "labelLimit": 130,
            "labelExpr": "[\"Where they live\", \"Parents’ education\", \"Parents’ job\", \"Indigenous status\", \"Language at home\", \"Gender\"][datum.value]"
          }
        },
        "tooltip": [
          {
            "field": "label",
            "title": "Factor"
          },
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "so",
            "title": "% meeting expectations",
            "format": ".1f"
          },
          {
            "field": "share",
            "title": "% of all students",
            "format": ".1f"
          }
        ]
      }
    },

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Indigenous gap by state and territory",
    "subtitle": "Each tile is one state or territory, placed roughly where it sits on the map."
  },
  "width": 440,
  "height": 440,
  "params": [
    {
      "name": "level",
      "value": 9
    },
    {
      "name": "domain",
      "value": "Numeracy"
    }
  ],
  "data": {
    "url": "data/equity_states.csv"
  },
  "transform": [
    {
      "filter": "datum.year == 2026 && datum.level == level && datum.domain == domain"
    }
  ],
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "paddingInner": 0.04,
        "paddingOuter": 0.02
      }
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "paddingInner": 0.04,
        "paddingOuter": 0.02
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "fill": "#e5e7eb"
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.gap)"
        }
      ],
      "mark": {
        "type": "rect"
      },
      "encoding": {
        "color": {
          "field": "gap",
          "type": "quantitative",
          "scale": {
            "scheme": "oranges",
            "domain": [
              15,
              60
            ]
          },
          "legend": {
            "title": "Gap (pts)",
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 160
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "indig",
            "title": "Indigenous students at Strong or above (%)"
          },
          {
            "field": "non",
            "title": "Non-Indigenous students (%)"
          },
          {
            "field": "gap",
            "title": "Gap (pts)",
            "format": ".1f"
          },
          {
            "field": "indigN",
            "title": "Indigenous students tested",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -34,
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#1f2a37"
      },
      "encoding": {
        "text": {
          "field": "abbr"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.gap)"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -4,
        "fontSize": 26,
        "fontWeight": 700,
        "color": "#1f2a37"
      },
      "encoding": {
        "text": {
          "field": "gap",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.gap)"
        },
        {
          "calculate": "format(datum.indig,'.0f') + '% vs ' + format(datum.non,'.0f') + '%'",
          "as": "pair"
        }
      ],
      "mark": {
        "type": "text",
        "dy": 22,
        "fontSize": 11,
        "color": "#1f2a37"
      },
      "encoding": {
        "text": {
          "field": "pair"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "!isValid(datum.gap)"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -2,
        "fontSize": 12,
        "color": "#6b7280"
      },
      "encoding": {
        "text": {
          "value": "Not published"
        }
      }
    }
  ],
  "config": {
    "font": "system-ui, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#374151",
      "titleColor": "#6b7280",
      "domainColor": "#cbd5e1",
      "gridColor": "#e5e7eb",
      "tickColor": "#cbd5e1"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#6b7280"
    },
    "title": {
      "fontSize": 13,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#1f2a37",
      "subtitleColor": "#6b7280",
      "subtitleFontSize": 12
    }
  }
}
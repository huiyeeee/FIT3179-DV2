{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How far is each group from the Australian average?",
    "subtitle": "Dots left of the line are below average. Figures on the right show the share of students at “Strong or above”."
  },
  "width": 560,
  "height": 621,
  "params": [
    {
      "name": "level",
      "value": 9
    },
    {
      "name": "domain",
      "value": "Numeracy"
    }
  ],
  "data": {
    "url": "data/equity_national.csv"
  },
  "transform": [
    {
      "filter": "datum.year == 2026 && datum.level == level && datum.domain == domain && datum.attr != 'All'"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "group": "#Parental education",
            "title": "PARENTAL EDUCATION"
          },
          {
            "group": "#Parental occupation",
            "title": "PARENTAL OCCUPATION"
          },
          {
            "group": "#Remoteness",
            "title": "REMOTENESS"
          },
          {
            "group": "#Indigenous status",
            "title": "INDIGENOUS STATUS"
          },
          {
            "group": "#Language background",
            "title": "LANGUAGE BACKGROUND"
          },
          {
            "group": "#Gender",
            "title": "GENDER"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#6b7280",
        "dx": 2
      },
      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": null,
          "scale": {
            "domain": [
              "#Parental education",
              "Bachelor degree or above",
              "Diploma",
              "Certificate (trade / TAFE)",
              "Year 12",
              "Year 11 or below",
              "#Parental occupation",
              "Senior managers & professionals",
              "Other managers & associate professionals",
              "Skilled trades, clerical & sales",
              "Unskilled manual, office & sales",
              "Not in paid work (12 months)",
              "#Remoteness",
              "Major cities",
              "Inner regional",
              "Outer regional",
              "Remote",
              "Very remote",
              "#Indigenous status",
              "Non-Indigenous",
              "Indigenous",
              "#Language background",
              "Language other than English at home",
              "English at home",
              "#Gender",
              "Male",
              "Female"
            ],
            "padding": 0.3
          },
          "axis": {
            "title": null,
            "domain": false,
            "ticks": false,
            "labelLimit": 230,
            "labelExpr": "substring(datum.label,0,1)=='#' ? '' : datum.label"
          }
        },
        "x": {
          "datum": -52,
          "type": "quantitative"
        },
        "text": {
          "field": "title"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#1f2a37",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5
      },
      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": null,
          "scale": {
            "domain": [
              "#Parental education",
              "Bachelor degree or above",
              "Diploma",
              "Certificate (trade / TAFE)",
              "Year 12",
              "Year 11 or below",
              "#Parental occupation",
              "Senior managers & professionals",
              "Other managers & associate professionals",
              "Skilled trades, clerical & sales",
              "Unskilled manual, office & sales",
              "Not in paid work (12 months)",
              "#Remoteness",
              "Major cities",
              "Inner regional",
              "Outer regional",
              "Remote",
              "Very remote",
              "#Indigenous status",
              "Non-Indigenous",
              "Indigenous",
              "#Language background",
              "Language other than English at home",
              "English at home",
              "#Gender",
              "Male",
              "Female"
            ],
            "padding": 0.3
          },
          "axis": {
            "title": null,
            "domain": false,
            "ticks": false,
            "labelLimit": 230,
            "labelExpr": "substring(datum.label,0,1)=='#' ? '' : datum.label"
          }
        },
        "x": {
          "field": "diff",
          "type": "quantitative"
        },
        "x2": {
          "datum": 0
        },
        "color": {
          "condition": {
            "test": "datum.diff >= 0",
            "value": "#1b7f79"
          },
          "value": "#d1572a"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "opacity": 0.95,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": null,
          "scale": {
            "domain": [
              "#Parental education",
              "Bachelor degree or above",
              "Diploma",
              "Certificate (trade / TAFE)",
              "Year 12",
              "Year 11 or below",
              "#Parental occupation",
              "Senior managers & professionals",
              "Other managers & associate professionals",
              "Skilled trades, clerical & sales",
              "Unskilled manual, office & sales",
              "Not in paid work (12 months)",
              "#Remoteness",
              "Major cities",
              "Inner regional",
              "Outer regional",
              "Remote",
              "Very remote",
              "#Indigenous status",
              "Non-Indigenous",
              "Indigenous",
              "#Language background",
              "Language other than English at home",
              "English at home",
              "#Gender",
              "Male",
              "Female"
            ],
            "padding": 0.3
          },
          "axis": {
            "title": null,
            "domain": false,
            "ticks": false,
            "labelLimit": 230,
            "labelExpr": "substring(datum.label,0,1)=='#' ? '' : datum.label"
          }
        },
        "x": {
          "field": "diff",
          "type": "quantitative",
          "scale": {
            "domain": [
              -52,
              38
            ],
            "nice": false
          },
          "axis": {
            "title": "Percentage points above / below the Australian average",
            "values": [
              -40,
              -30,
              -20,
              -10,
              0,
              10,
              20
            ],
            "grid": true
          }
        },
        "size": {
          "field": "enrolled",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "range": [
              40,
              520
            ]
          },
          "legend": {
            "title": "Students in group",
            "orient": "top",
            "direction": "horizontal",
            "format": ","
          }
        },
        "color": {
          "condition": {
            "test": "datum.diff >= 0",
            "value": "#1b7f79"
          },
          "value": "#d1572a"
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "strongPlus",
            "title": "Strong or above (%)"
          },
          {
            "field": "avg",
            "title": "Australian average (%)"
          },
          {
            "field": "diff",
            "title": "Difference (pts)",
            "format": "+.1f"
          },
          {
            "field": "enrolled",
            "title": "Students",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#1f2a37"
      },
      "transform": [
        {
          "calculate": "format(datum.strongPlus,'.0f') + '%'",
          "as": "lab"
        }
      ],
      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": null,
          "scale": {
            "domain": [
              "#Parental education",
              "Bachelor degree or above",
              "Diploma",
              "Certificate (trade / TAFE)",
              "Year 12",
              "Year 11 or below",
              "#Parental occupation",
              "Senior managers & professionals",
              "Other managers & associate professionals",
              "Skilled trades, clerical & sales",
              "Unskilled manual, office & sales",
              "Not in paid work (12 months)",
              "#Remoteness",
              "Major cities",
              "Inner regional",
              "Outer regional",
              "Remote",
              "Very remote",
              "#Indigenous status",
              "Non-Indigenous",
              "Indigenous",
              "#Language background",
              "Language other than English at home",
              "English at home",
              "#Gender",
              "Male",
              "Female"
            ],
            "padding": 0.3
          },
          "axis": {
            "title": null,
            "domain": false,
            "ticks": false,
            "labelLimit": 230,
            "labelExpr": "substring(datum.label,0,1)=='#' ? '' : datum.label"
          }
        },
        "x": {
          "datum": 38,
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        }
      }
    }
  ],
  "config": {
    "font": "system-ui, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#374151",
      "titleColor": "#6b7280",
      "domainColor": "#cbd5e1",
      "gridColor": "#e5e7eb",
      "tickColor": "#cbd5e1"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "titleColor": "#6b7280"
    },
    "title": {
      "fontSize": 13,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#1f2a37",
      "subtitleColor": "#6b7280",
      "subtitleFontSize": 12
    }
  }
}
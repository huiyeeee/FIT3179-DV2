              2,
              3,
              4
            ],
            "grid": false,
            "labelFontSize": 12,
            "labelFontWeight": 600,
            "labelColor": "#14213d",
            "labelPadding": 8,
            "labelLimit": 130,
            "labelExpr": "[\"Parents’ education\", \"Parents’ job\", \"Indigenous status\", \"Language at home\", \"Gender\"][datum.value]"
          }
        },
        "color": {
          "field": "k",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "sel",
              "all",
              "other"
            ],
            "range": [
              "#f0745a",
              "#1f6f8b",
              "#bcc5d6"
            ]
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "gap",
            "title": "Gap (points)",
            "format": ".1f"
          },

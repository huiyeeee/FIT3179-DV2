        }
      ],
      "mark": {
        "type": "tick",
        "color": "#14213d",
        "thickness": 3,
        "size": 30
      },
      "encoding": {
        "x": {
          "field": "gap",
          "type": "quantitative",
          "scale": {
            "domain": [
              -25,
              60
            ],
            "nice": false
          }
        },
        "y": {
          "field": "row",
          "scale": {
            "domain": [
              -0.5,

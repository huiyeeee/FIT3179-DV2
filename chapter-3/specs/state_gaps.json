        }
      }
    },
    {
      "data": {
        "url": "chapter-3/data/state_gaps.csv",
        "format": {
          "type": "csv",
          "parse": {
            "so_low": "number",
            "so_high": "number",
            "gap": "number",
            "n_low": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "indexof([\"edu\", \"job\", \"ind\", \"lang\", \"sex\"], datum.factor)",
          "as": "row"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#d5dbe5",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": -25,
          "type": "quantitative",
          "scale": {
            "domain": [
              -25,
              60
            ],
            "nice": false
          }
        },
        "x2": {
          "datum": 60
        },
        "y": {
          "field": "row",
          "scale": {
            "domain": [
              -0.5,
              4.5
            ],
            "reverse": true,
            "nice": false
          },
          "type": "quantitative",
          "axis": {
            "title": null,
            "values": [
              0,
              1,
              2,
              3,
              4
            ],
            "grid": false,
            "labelFontSize": 12,
            "labelFontWeight": 600,
            "labelColor": "#14213d",
            "labelPadding": 8,
            "labelLimit": 130,
            "labelExpr": "[\"Parents’ education\", \"Parents’ job\", \"Indigenous status\", \"Language at home\", \"Gender\"][datum.value]"
          }
        }
      }
    },
    {
      "data": {
        "url": "chapter-3/data/state_gaps.csv",
        "format": {
          "type": "csv",
          "parse": {
            "so_low": "number",
            "so_high": "number",
            "gap": "number",
            "n_low": "number"
          }
        }
      },
      "transform": [

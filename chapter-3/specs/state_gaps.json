            "title": "Lower group: % meeting expectations",
            "format": ".0f"
          },
          {
            "field": "n_low",
            "title": "Students in the lower group",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "chapter-3/data/state_gaps.csv",
        "format": {
          "type": "csv",
          "parse": {
            "so_low": "number",
            "so_high": "number",
            "gap": "number",
            "n_low": "number"
          }
        }
      },
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": "gap",
              "as": "gmin"
            },
            {
              "op": "max",
              "field": "gap",
              "as": "gmax"
            }
          ],
          "groupby": [
            "factor"
          ]
        },
        {
          "calculate": "indexof([\"edu\", \"job\", \"ind\", \"lang\", \"sex\"], datum.factor)",
          "as": "row"
        },
        {
          "calculate": "datum.state == 'Australian Capital Territory' ? 'ACT' : datum.state == 'New South Wales' ? 'NSW' : datum.state == 'Northern Territory' ? 'NT' : datum.state == 'Queensland' ? 'QLD' : datum.state == 'South Australia' ? 'SA' : datum.state == 'Victoria' ? 'VIC' : 'WA'",
          "as": "ab"
        },
        {
          "filter": "datum.state == st || (st == '' && datum.gmax - datum.gmin > 3 && (datum.gap == datum.gmax || datum.gap == datum.gmin))"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -15,
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#4a5568"
      },
      "encoding": {
        "x": {
          "field": "gap",
          "type": "quantitative",
          "scale": {
            "domain": [
              -25,
              60
            ],
            "nice": false
          }
        },
        "y": {
          "field": "row",
          "scale": {
            "domain": [
              -0.5,
              4.5
            ],
            "reverse": true,
            "nice": false
          },
          "type": "quantitative",
          "axis": {
            "title": null,
            "values": [
              0,
              1,
              2,
              3,
              4
            ],
            "grid": false,
            "labelFontSize": 12,
            "labelFontWeight": 600,
            "labelColor": "#14213d",
            "labelPadding": 8,
            "labelLimit": 130,
            "labelExpr": "[\"Parents’ education\", \"Parents’ job\", \"Indigenous status\", \"Language at home\", \"Gender\"][datum.value]"
          }
        },
        "text": {
          "field": "ab"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Spread across states"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",

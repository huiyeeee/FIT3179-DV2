{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dot strip. For each background, the gap in the share of students meeting expectations in each state or territory, 2026 (higher group minus lower group; for gender, girls minus boys; for language, other-than-English minus English only). A dark tick marks Australia. Tasmania is left out because its results by background are not published.",
  "width": "container",
  "height": 280,
  "padding": {
    "left": 4,
    "right": 8,
    "top": 34,
    "bottom": 4
  },
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "axis": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontWeight": 500,
      "titleFontSize": 11,
      "domain": false,
      "ticks": false,
      "gridColor": "#eee8dc"
    }
  },
  "params": [
    {
      "name": "st",
      "value": ""
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "x": 0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#14213d",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              -25,
              60
            ],
            "nice": false
          },
          "axis": {
            "title": "Gap in the share meeting expectations (percentage points)",
            "grid": true,
            "values": [
              -20,
              0,
              20,
              40,
              60
            ],
            "labelExpr": "(datum.value > 0 ? '+' : datum.value < 0 ? '−' : '') + abs(datum.value)"

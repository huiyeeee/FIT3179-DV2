          "field": "t"
        }
      }
    },
    {
      "data": {
        "url": "chapter-3/data/state_gaps.csv",
        "format": {
          "type": "csv",
          "parse": {
            "so_low": "number",
            "so_high": "number",
            "gap": "number",
            "n_low": "number"
          }
        }
      },
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": "gap",
              "as": "gmin"
            },
            {
              "op": "max",
              "field": "gap",
              "as": "gmax"
            }
          ],
          "groupby": [
            "factor"
          ]
        },
        {
          "calculate": "indexof([\"edu\", \"job\", \"ind\", \"lang\", \"sex\"], datum.factor)",
          "as": "row"
        },
        {
          "aggregate": [
            {
              "op": "max",
              "field": "gmin",
              "as": "gmin"
            },
            {
              "op": "max",
              "field": "gmax",
              "as": "gmax"
            }
          ],
          "groupby": [
            "factor",
            "row"
          ]
        },
        {
          "calculate": "(datum.gmin < 0 ? '−' : '') + format(abs(datum.gmin), '.0f') + ' to ' + (datum.gmax < 0 ? '−' : '') + format(abs(datum.gmax), '.0f') + ' pts'",
          "as": "rg"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 14,
        "fontSize": 12.5,
        "fontWeight": 700,
        "color": "#14213d"
      },
      "encoding": {
        "x": {
          "datum": 60,
          "type": "quantitative",
          "scale": {
            "domain": [
              -25,
              60
            ],
            "nice": false
          }
        },
        "y": {
          "field": "row",
          "scale": {

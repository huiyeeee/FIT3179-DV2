          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "gap",
            "title": "Gap (points)",
            "format": ".1f"
          },
          {
            "field": "so_high",
            "title": "Higher group: % meeting expectations",
            "format": ".0f"
          },
          {
            "field": "so_low",
            "title": "Lower group: % meeting expectations",
            "format": ".0f"
          },
          {
            "field": "n_low",
            "title": "Students in the lower group",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "chapter-3/data/factors.csv",
        "format": {
          "type": "csv",
          "parse": {
            "gap": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "indexof([\"edu\", \"job\", \"ind\", \"lang\", \"sex\"], datum.factor) >= 0"

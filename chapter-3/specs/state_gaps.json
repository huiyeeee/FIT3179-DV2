              1,
              2,
              3,
              4
            ],
            "grid": false,
            "labelFontSize": 12,
            "labelFontWeight": 600,
            "labelColor": "#14213d",
            "labelPadding": 8,
            "labelLimit": 130,
            "labelExpr": "[\"Parents’ education\", \"Parents’ job\", \"Indigenous status\", \"Language at home\", \"Gender\"][datum.value]"
          }
        },
        "text": {
          "field": "rg"
        }
      }
    },

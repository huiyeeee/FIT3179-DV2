          "as": "label"
        },
        {
          "filter": "datum.ext == 0"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 700
      },
      "encoding": {
        "longitude": {
          "field": "cx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "cy",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "field": "ink",
          "type": "nominal",
          "scale": null,
          "legend": null
        }
      }
    },
    {
      "data": {
        "url": "chapter-2/data/cartogram.geojson",
        "format": {
          "type": "json",

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Contiguous area cartogram of the states and territories. Each state is redrawn so its area is proportional to its students tested, while neighbours still touch. Colour = how many percentage points the share meeting expectations is above or below Australia's. Tasmania is not published.",
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 4,
    "right": 4,
    "top": 4,
    "bottom": 4
  },
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "axis": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontWeight": 500,
      "titleFontSize": 11,
      "domain": false,
      "ticks": false,
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "labelFontSize": 11
    }
  },
  "params": [
    {
      "name": "sel",
      "value": "Northern Territory"
    }
  ],
  "projection": {
    "type": "identity"
  },
  "layer": [
    {
      "data": {
        "url": "chapter-2/data/cartogram.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "chapter-2/data/cartogram_labels.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "cx": "number",
                  "cy": "number",
                  "lx": "number",
                  "ly": "number",
                  "ext": "number",
                  "side": "number",
                  "area_share": "number",
                  "students_share": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "cx",
              "cy",
              "lx",
              "ly",
              "ext",
              "side",
              "students_share"
            ]
          }
        },
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "chapter-2/data/map_latest.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "year": "number",
                  "n": "number",
                  "so": "number",
                  "nas": "number",
                  "gap_so": "number",
                  "gap_nas": "number",
                  "nat_so": "number",
                  "reported": "number",
                  "lon": "number",
                  "lat": "number",
                  "anchor_lon": "number",
                  "anchor_lat": "number",
                  "leader": "number",
                  "land_pct": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "state",
              "code",
              "so",
              "gap_so",
              "band_so",
              "n",
              "nat_so",
              "reported"
            ]
          }
        },
        {
          "calculate": "datum.reported == 1 ? datum.band_so : 'Not published'",
          "as": "band"
        },
        {
          "calculate": "(datum.gap_so > 0 ? '+' : '−') + format(abs(datum.gap_so), '.1f') + ' points'",
          "as": "gap_label"
        },
        {
          "calculate": "datum.reported == 1 ? format(datum.so, '.1f') + '%' : 'not published'",
          "as": "value_label"
        },
        {
          "calculate": "format(datum.nat_so, '.1f') + '%'",
          "as": "nat_label"
        },
        {
          "calculate": "format(datum.n, ',') + ' (' + format(datum.n / 6103856 * 100, '.1f') + '% of Australia)'",
          "as": "n_label"
        },
        {
          "calculate": "indexof(['10+ pp worse', '3+ pp better'], datum.band) >= 0 ? '#ffffff' : '#14213d'",
          "as": "ink"
        },
        {
          "calculate": "width < 420 ? datum.code : datum.reported == 1 ? datum.code + ' ' + format(datum.so, '.0f') + '%' : datum.code + ' not published'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "geoshape",
        "cursor": "pointer",
        "tooltip": true,
        "strokeJoin": "round"
      },
      "encoding": {
        "fill": {
          "field": "band",
          "type": "nominal",
          "scale": {
            "domain": [
              "10+ pp worse",
              "3-10 pp worse",
              "1-3 pp worse",
              "within 1 pp",
              "1-3 pp better",
              "3+ pp better",
              "Not published"
            ],
            "range": [
              "#c2410c",
              "#f0745a",
              "#f8cbbd",
              "#ece8df",
              "#9fc9d8",
              "#0e5a78",
              "#e3e3e3"
            ]
          },
          "legend": null
        },
        "stroke": {
          "condition": {
            "test": "datum.state == sel",
            "value": "#14213d"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.state == sel",
            "value": 2
          },
          "value": 1.2
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "value_label",
            "title": "Meeting expectations"
          },
          {
            "field": "nat_label",
            "title": "Australia"
          },
          {
            "field": "gap_label",
            "title": "Difference"
          },
          {
            "field": "n_label",
            "title": "Students tested"
          }
        ]
      }
    },
    {
      "data": {
        "url": "chapter-2/data/cartogram_labels.csv",
        "format": {
          "type": "csv",
          "parse": {
            "cx": "number",
            "cy": "number",
            "lx": "number",
            "ly": "number",
            "ext": "number",
            "side": "number",
            "area_share": "number",
            "students_share": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.ext == 1"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#9aa3b2",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "ly",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "cx"
        },
        "latitude2": {
          "field": "cy"
        }
      }
    },
    {
      "data": {
        "url": "chapter-2/data/cartogram.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

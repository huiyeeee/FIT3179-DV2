        "align": "left",
        "dx": 6,
        "fontSize": 12.5,
        "fontWeight": 700,
        "color": "#14213d"
      },
      "encoding": {
        "longitude": {
          "field": "lx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "ly",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },

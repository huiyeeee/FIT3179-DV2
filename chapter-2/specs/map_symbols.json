{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map of Australian states. Circle area = number of students meeting expectations; colour = above or below the Australian share meeting expectations. Tasmania is not published. Annotations are supplied by the page.",
  "width": "container",
  "height": "container",
  "padding": {
    "left": 0,
    "right": 0,
    "top": 0,
    "bottom": 0
  },
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "axis": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontWeight": 500,
      "titleFontSize": 11,
      "domain": false,
      "ticks": false,
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "labelFontSize": 11
    }
  },
  "params": [
    {
      "name": "sel",
      "value": "Northern Territory"
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "parallels": [
      -18,
      -36
    ],
    "center": [
      0,
      -27
    ],
    "scale": {
      "expr": "width < 600 ? min(width * 1.05, height * 1.05) : min(width * 1.3, height * 1.3)"
    },
    "translate": {
      "expr": "[width / 2, height / 2]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "chapter-2/data/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1efe9",
        "stroke": "#ffffff",
        "strokeWidth": 1.4
      }
    },
    {
      "data": {
        "url": "chapter-2/data/map_latest.csv",
        "format": {
          "type": "csv",
          "parse": {
            "n": "number",
            "so": "number",
            "nat_so": "number",
            "gap_so": "number",
            "lon": "number",
            "lat": "number",
            "anchor_lon": "number",
            "anchor_lat": "number",
            "reported": "number",
            "leader": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.leader == 1"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#9aa3b2",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "anchor_lon"
        },
        "latitude2": {
          "field": "anchor_lat"
        }
      }
    },
    {
      "data": {
        "url": "chapter-2/data/map_latest.csv",
        "format": {
          "type": "csv",
          "parse": {
            "n": "number",
            "so": "number",
            "nat_so": "number",
            "gap_so": "number",
            "lon": "number",
            "lat": "number",
            "anchor_lon": "number",
            "anchor_lat": "number",
            "reported": "number",
            "leader": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.reported == 1"
        },
        {
          "calculate": "{'NSW': 148.6, 'VIC': 143.6, 'QLD': 144.5, 'ACT': 155.0}[datum.code] || datum.lon",
          "as": "sx"
        },
        {
          "calculate": "{'NSW': -32.2, 'VIC': -37.6, 'ACT': -36.6}[datum.code] || datum.lat",
          "as": "sy"
        },
        {
          "calculate": "datum.band_so",
          "as": "band"
        },
        {
          "calculate": "datum.n * datum.so / 100",
          "as": "meet"
        },
        {
          "calculate": "'about ' + format(round(datum.n / 1000), ',') + ',000 students'",
          "as": "n_label"
        },
        {
          "calculate": "'about ' + format(round(datum.meet / 1000), ',') + ',000 (' + format(datum.so, '.1f') + '%)'",
          "as": "meet_label"
        },
        {
          "calculate": "format(datum.nat_so, '.1f') + '%'",
          "as": "nat_label"
        },
        {
          "calculate": "(datum.gap_so > 0 ? '+' : '−') + format(abs(datum.gap_so), '.1f') + ' points'",
          "as": "gap_label"
        },
        {
          "calculate": "width < 420 ? datum.code : datum.code + ' ' + format(datum.so, '.0f') + '%'",
          "as": "label"
        },
        {
          "calculate": "datum.sy + (sqrt(datum.meet / 2000000 * (width < 600 ? 2200 : 8500) / PI) + 5) * 180 / (PI * (width < 600 ? min(width * 1.05, height * 1.05) : min(width * 1.3, height * 1.3)))",
          "as": "ly"
        }
      ],
      "mark": {
        "type": "circle",
        "fillOpacity": 0.9,
        "cursor": "pointer",
        "tooltip": true
      },
      "encoding": {
        "longitude": {
          "field": "sx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "sy",
          "type": "quantitative"
        },
        "color": {
          "field": "band",
          "type": "nominal",
          "scale": {
            "domain": [
              "10+ pp worse",
              "3-10 pp worse",
              "1-3 pp worse",
              "within 1 pp",
              "1-3 pp better",
              "3+ pp better"
            ],
            "range": [
              "#c2410c",
              "#f0745a",
              "#f4a994",
              "#b8b2a4",
              "#7fb3c7",
              "#0e5a78"
            ]
          },
          "legend": null
        },
        "size": {
          "field": "meet",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              2000000
            ],
            "range": [
              0,
              8500
            ]
          },
          "legend": null
        },
        "stroke": {
          "condition": {
            "test": "datum.state == sel",
            "value": "#14213d"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.state == sel",
            "value": 2.8
          },
          "value": 1.5
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "meet_label",
            "title": "Meeting expectations"
          },
          {
            "field": "n_label",
            "title": "Students tested"
          },
          {
            "field": "nat_label",
            "title": "Australia"
          },
          {
            "field": "gap_label",
            "title": "Difference"
          }
        ]
      }
    },
    {
      "data": {
        "url": "chapter-2/data/map_latest.csv",
        "format": {
          "type": "csv",
          "parse": {
            "n": "number",
            "so": "number",
            "nat_so": "number",
            "gap_so": "number",
            "lon": "number",
            "lat": "number",
            "anchor_lon": "number",
            "anchor_lat": "number",
            "reported": "number",
            "leader": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.reported == 1"
        },
        {
          "calculate": "{'NSW': 148.6, 'VIC': 143.6, 'QLD': 144.5, 'ACT': 155.0}[datum.code] || datum.lon",
          "as": "sx"
        },
        {
          "calculate": "{'NSW': -32.2, 'VIC': -37.6, 'ACT': -36.6}[datum.code] || datum.lat",
          "as": "sy"
        },
        {
          "calculate": "datum.band_so",
          "as": "band"
        },
        {
          "calculate": "datum.n * datum.so / 100",
          "as": "meet"
        },
        {
          "calculate": "'about ' + format(round(datum.n / 1000), ',') + ',000 students'",
          "as": "n_label"
        },
        {
          "calculate": "'about ' + format(round(datum.meet / 1000), ',') + ',000 (' + format(datum.so, '.1f') + '%)'",
          "as": "meet_label"
        },
        {
          "calculate": "format(datum.nat_so, '.1f') + '%'",
          "as": "nat_label"
        },
        {
          "calculate": "(datum.gap_so > 0 ? '+' : '−') + format(abs(datum.gap_so), '.1f') + ' points'",
          "as": "gap_label"
        },
        {
          "calculate": "width < 420 ? datum.code : datum.code + ' ' + format(datum.so, '.0f') + '%'",
          "as": "label"
        },
        {
          "calculate": "datum.sy + (sqrt(datum.meet / 2000000 * (width < 600 ? 2200 : 8500) / PI) + 5) * 180 / (PI * (width < 600 ? min(width * 1.05, height * 1.05) : min(width * 1.3, height * 1.3)))",
          "as": "ly"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#14213d"
      },
      "encoding": {
        "longitude": {
          "field": "sx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "ly",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "chapter-2/data/map_latest.csv",
        "format": {
          "type": "csv",
          "parse": {
            "n": "number",
            "so": "number",
            "nat_so": "number",
            "gap_so": "number",
            "lon": "number",
            "lat": "number",
            "anchor_lon": "number",
            "anchor_lat": "number",
            "reported": "number",
            "leader": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.reported == 0"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "color": "#6b7280",
        "fontStyle": "italic"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "value": "TAS: not published"
        }
      }
    },
    {
      "data": {
        "name": "annot"
      },
      "transform": [
        {
          "filter": "isValid(datum.lon2)"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1.2,
        "strokeDash": [
          3,
          2
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon2",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat2",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon3"
        },
        "latitude2": {
          "field": "lat3"
        },
        "color": {
          "field": "color",
          "type": "nominal",
          "scale": null,
          "legend": null
        }
      }
    },
    {
      "data": {
        "name": "annot"
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11.5,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 14
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        },
        "color": {
          "field": "color",
          "type": "nominal",
          "scale": null,
          "legend": null
        }
      }
    }
  ]
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map of Australian states. Circle area = number of students exceeding expectations; colour = how far the share exceeding is above or below Australia's. Tasmania is not published.",
  "width": "container",
  "height": "container",
  "padding": {
    "left": 0,
    "right": 0,
    "top": 0,
    "bottom": 0
  },
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "axis": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontWeight": 500,
      "titleFontSize": 11,
      "domain": false,
      "ticks": false,
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "labelFontSize": 11
    }
  },
  "params": [
    {
      "name": "sel",
      "value": "Northern Territory"
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "parallels": [
      -18,
      -36
    ],
    "center": [
      0,
      -27
    ],
    "scale": {
      "expr": "width < 600 ? min(width * 1.05, height * 1.05) : min(width * 1.3, height * 1.3)"
    },
    "translate": {
      "expr": "[width / 2, height / 2]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "chapter-2/data/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1efe9",
        "stroke": "#ffffff",
        "strokeWidth": 1.4
      }
    },
    {
      "data": {
        "url": "chapter-2/data/map_latest.csv",
        "format": {
          "type": "csv",
          "parse": {
            "n": "number",
            "so": "number",
            "exceed": "number",
            "lon": "number",
            "lat": "number",
            "anchor_lon": "number",
            "anchor_lat": "number",
            "reported": "number",
            "leader": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.leader == 1"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#9aa3b2",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "anchor_lon"
        },
        "latitude2": {
          "field": "anchor_lat"
        }
      }
    },
    {
      "data": {
        "url": "chapter-2/data/map_latest.csv",
        "format": {
          "type": "csv",
          "parse": {
            "n": "number",
            "so": "number",
            "exceed": "number",
            "lon": "number",
            "lat": "number",
            "anchor_lon": "number",
            "anchor_lat": "number",
            "reported": "number",
            "leader": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.reported == 1"
        },
        {
          "calculate": "{'NSW': 148.6, 'VIC': 143.6, 'QLD': 144.5, 'ACT': 155.0}[datum.code] || datum.lon",
          "as": "sx"
        },
        {
          "calculate": "{'NSW': -32.2, 'VIC': -37.6, 'ACT': -36.6}[datum.code] || datum.lat",
          "as": "sy"
        },
        {
          "calculate": "datum.exceed - 16.3440",
          "as": "gap_ex"
        },
        {
          "calculate": "datum.gap_ex <= -5 ? '5+ below' : datum.gap_ex <= -2 ? '2–5 below' : datum.gap_ex < 2 ? 'within 2' : '2+ above'",
          "as": "band"
        },
        {
          "calculate": "datum.n * datum.exceed / 100",
          "as": "cnt"
        },
        {
          "calculate": "'about ' + format(round(datum.cnt / 1000), ',') + ',000 students (' + format(datum.exceed, '.1f') + '%)'",
          "as": "cnt_label"
        },
        {
          "calculate": "format(16.3, '.1f') + '%'",
          "as": "nat_label"
        },
        {
          "calculate": "(datum.gap_ex > 0 ? '+' : '−') + format(abs(datum.gap_ex), '.1f') + ' points'",
          "as": "gap_label"
        },
        {
          "calculate": "width < 420 ? datum.code : datum.code + ' ' + format(datum.exceed, '.0f') + '%'",
          "as": "label"
        },
        {
          "calculate": "datum.sy + (sqrt(datum.cnt / 400000 * (width < 600 ? 1700 : 6500) / PI) + 5) * 180 / (PI * (width < 600 ? min(width * 1.05, height * 1.05) : min(width * 1.3, height * 1.3)))",
          "as": "ly"
        }
      ],
      "mark": {
        "type": "circle",
        "fillOpacity": 0.9,
        "cursor": "pointer",
        "tooltip": true
      },
      "encoding": {
        "longitude": {
          "field": "sx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "sy",
          "type": "quantitative"
        },
        "color": {
          "field": "band",
          "type": "nominal",
          "scale": {
            "domain": [
              "5+ below",
              "2–5 below",
              "within 2",
              "2+ above"
            ],
            "range": [
              "#c2410c",
              "#f0745a",
              "#b8b2a4",
              "#7fb3c7"
            ]
          },
          "legend": null
        },
        "size": {
          "field": "cnt",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              400000
            ],
            "range": [
              0,
              6500
            ]
          },
          "legend": null
        },
        "stroke": {
          "condition": {
            "test": "datum.state == sel",
            "value": "#14213d"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.state == sel",
            "value": 2.8
          },
          "value": 1.5
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "cnt_label",
            "title": "Exceeding expectations"
          },
          {
            "field": "nat_label",
            "title": "Australia"
          },
          {
            "field": "gap_label",
            "title": "Difference"
          }
        ]
      }
    },
    {
      "data": {
        "url": "chapter-2/data/map_latest.csv",
        "format": {
          "type": "csv",
          "parse": {
            "n": "number",
            "so": "number",
            "exceed": "number",
            "lon": "number",
            "lat": "number",
            "anchor_lon": "number",
            "anchor_lat": "number",
            "reported": "number",
            "leader": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.reported == 1"
        },
        {
          "calculate": "{'NSW': 148.6, 'VIC': 143.6, 'QLD': 144.5, 'ACT': 155.0}[datum.code] || datum.lon",
          "as": "sx"
        },
        {
          "calculate": "{'NSW': -32.2, 'VIC': -37.6, 'ACT': -36.6}[datum.code] || datum.lat",
          "as": "sy"
        },
        {
          "calculate": "datum.exceed - 16.3440",
          "as": "gap_ex"
        },
        {
          "calculate": "datum.gap_ex <= -5 ? '5+ below' : datum.gap_ex <= -2 ? '2–5 below' : datum.gap_ex < 2 ? 'within 2' : '2+ above'",
          "as": "band"
        },
        {
          "calculate": "datum.n * datum.exceed / 100",
          "as": "cnt"
        },
        {
          "calculate": "'about ' + format(round(datum.cnt / 1000), ',') + ',000 students (' + format(datum.exceed, '.1f') + '%)'",
          "as": "cnt_label"
        },
        {
          "calculate": "format(16.3, '.1f') + '%'",
          "as": "nat_label"
        },
        {
          "calculate": "(datum.gap_ex > 0 ? '+' : '−') + format(abs(datum.gap_ex), '.1f') + ' points'",
          "as": "gap_label"
        },
        {
          "calculate": "width < 420 ? datum.code : datum.code + ' ' + format(datum.exceed, '.0f') + '%'",
          "as": "label"
        },
        {
          "calculate": "datum.sy + (sqrt(datum.cnt / 400000 * (width < 600 ? 1700 : 6500) / PI) + 5) * 180 / (PI * (width < 600 ? min(width * 1.05, height * 1.05) : min(width * 1.3, height * 1.3)))",
          "as": "ly"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#14213d"
      },
      "encoding": {
        "longitude": {
          "field": "sx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "ly",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "chapter-2/data/map_latest.csv",
        "format": {
          "type": "csv",
          "parse": {
            "n": "number",
            "so": "number",
            "exceed": "number",
            "lon": "number",
            "lat": "number",
            "anchor_lon": "number",
            "anchor_lat": "number",
            "reported": "number",
            "leader": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.reported == 0"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "color": "#6b7280",
        "fontStyle": "italic"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "value": "TAS: not published"
        }
      }
    },
    {
      "data": {
        "name": "annot"
      },
      "transform": [
        {
          "filter": "isValid(datum.lon2)"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1.2,
        "strokeDash": [
          3,
          2
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon2",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat2",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon3"
        },
        "latitude2": {
          "field": "lat3"
        },
        "color": {
          "condition": {
            "test": "datum.color == '#c2410c'",
            "value": "#c2410c"
          },
          "value": "#4a5568"
        }
      }
    },
    {
      "data": {
        "name": "annot"
      },
      "transform": [
        {
          "filter": "isValid(datum.text)"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11.5,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 14
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        },
        "color": {
          "condition": {
            "test": "datum.color == '#c2410c'",
            "value": "#c2410c"
          },
          "value": "#4a5568"
        }
      }
    }
  ]
}

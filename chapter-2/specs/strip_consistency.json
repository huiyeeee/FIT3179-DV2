            "title": null,
            "values": [
              0,
              1,
              2,
              3,
              4,
              5,
              6,
              7
            ],
            "grid": false,
            "labelFontSize": 12,
            "labelFontWeight": 600,
            "labelColor": "#14213d",
            "labelPadding": 8,
            "labelExpr": "width < 600 ? [\"VIC\", \"ACT\", \"NSW\", \"WA\", \"SA\", \"QLD\", \"TAS\", \"NT\"][datum.value] : [\"Victoria\", \"ACT\", \"New South Wales\", \"Western Australia\", \"South Australia\", \"Queensland\", \"Tasmania\", \"Northern Territory\"][datum.value]"
          }

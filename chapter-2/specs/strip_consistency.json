    {
      "data": {
        "url": "chapter-2/data/state_cells.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "level": "number",
            "so": "number",
            "n": "number",
            "nat_so": "number",
            "gap": "number",
            "sig": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == year"
        },
        {
          "calculate": "datum.gap < 0 ? 1 : 0",
          "as": "is_below"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "is_below",
              "as": "n_below"
            },
            {
              "op": "count",
              "as": "n_total"
            }
          ],
          "groupby": [
            "state"
          ]
        },
        {
          "calculate": "datum.n_below == 0 ? 'all ' + datum.n_total + ' above' : datum.n_below == datum.n_total ? 'all ' + datum.n_total + ' below' : datum.n_below + ' of ' + datum.n_total + ' below'",
          "as": "summary"
        },
        {
          "calculate": "datum.n_below == 0 ? '#1f6f8b' : datum.n_below == datum.n_total ? '#c2410c' : '#4a5568'",
          "as": "summary_color"
        },
        {
          "calculate": "indexof([\"Victoria\", \"Australian Capital Territory\", \"New South Wales\", \"Western Australia\", \"South Australia\", \"Queensland\", \"Tasmania\", \"Northern Territory\"], datum.state)",
          "as": "state_idx"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 700,
        "dx": 10
      },
      "encoding": {
        "x": {
          "datum": 12,
          "type": "quantitative",
          "scale": {
            "domain": [
              -34,
              12

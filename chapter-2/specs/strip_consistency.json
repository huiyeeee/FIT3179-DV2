    },
    {
      "data": {
        "url": "chapter-2/data/state_cells.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "level": "number",
            "so": "number",
            "n": "number",
            "nat_so": "number",
            "gap": "number",
            "sig": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == year"
        },
        {
          "calculate": "indexof([\"Victoria\", \"Australian Capital Territory\", \"New South Wales\", \"Western Australia\", \"South Australia\", \"Queensland\", \"Tasmania\", \"Northern Territory\"], datum.state)",
          "as": "state_idx"
        },
        {
          "calculate": "indexof([\"Reading\", \"Writing\", \"Spelling\", \"Grammar and Punctuation\", \"Numeracy\"], datum.domain)",
          "as": "dom_idx"
        },
        {
          "calculate": "datum.state_idx + (mode == 'level' ? (indexof([3, 5, 7, 9], datum.level) - 1.5) * 0.2 : (datum.dom_idx - 2) * 0.17)",
          "as": "y"
        },
        {
          "calculate": "mode == 'all' ? (datum.gap >= 0 ? 'Above Australia' : 'Below Australia') : mode == 'level' ? 'Year ' + datum.level : datum.domain",
          "as": "key"
        },
        {
          "calculate": "'Year ' + datum.level + ' ' + datum.domain",
          "as": "test"
        },
        {
          "calculate": "datum.sig == 0 ? 'Too close to call' : datum.sig > 0 ? 'Clearly above Australia' : 'Clearly below Australia'",
          "as": "clear"
        },
        {
          "filter": "datum.sig != 0"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 60,
        "opacity": 0.92,
        "stroke": "#ffffff",
        "strokeWidth": 0.8,
        "cursor": "pointer",
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "gap",
          "type": "quantitative",
          "scale": {
            "domain": [
              -34,
              12
            ],
            "nice": false
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.5,
              7.5
            ],
            "reverse": true,
            "nice": false
          },
          "axis": {
            "title": null,
            "values": [
              0,
              1,
              2,
              3,
              4,
              5,
              6,
              7
            ],
            "grid": false,
            "labelFontSize": 12,
            "labelFontWeight": 600,
            "labelColor": "#14213d",
            "labelPadding": 8,
            "labelExpr": "width < 600 ? [\"VIC\", \"ACT\", \"NSW\", \"WA\", \"SA\", \"QLD\", \"TAS\", \"NT\"][datum.value] : [\"Victoria\", \"ACT\", \"New South Wales\", \"Western Australia\", \"South Australia\", \"Queensland\", \"Tasmania\", \"Northern Territory\"][datum.value]"
          }
        },
        "color": {
          "field": "key",
          "type": "nominal",
          "scale": {
            "domain": [
              "Below Australia",
              "Above Australia",
              "Year 3",
              "Year 5",
              "Year 7",
              "Year 9",
              "Reading",
              "Writing",
              "Spelling",
              "Grammar and Punctuation",
              "Numeracy"
            ],
            "range": [
              "#f0745a",
              "#1f6f8b",
              "#cbd5e1",
              "#94a3b8",
              "#556987",
              "#1e2f4d",
              "#c2410c",
              "#1f6f8b",
              "#7b5ea7",
              "#b8860b",
              "#4b5563"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "test",
            "title": "Test"
          },
          {
            "field": "so",
            "title": "% meeting expectations",
            "format": ".1f"
          },
          {
            "field": "nat_so",
            "title": "Australia, same test (%)",
            "format": ".1f"
          },
          {
            "field": "gap",
            "title": "Difference (points)",
            "format": "+.1f"
          },
          {
            "field": "clear",
            "title": "Is the gap clear?"
          }
        ]
      }
    },

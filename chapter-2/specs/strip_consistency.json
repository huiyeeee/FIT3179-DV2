{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dot strip plot. Each dot is one result (a subject at a year level) for one state, placed by how many percentage points it is above or below the Australian result for the same test. Filled dots are clear gaps; hollow dots are too close to call.",
  "width": "container",
  "height": 416,
  "padding": {
    "left": 4,
    "right": 8,
    "top": 34,
    "bottom": 4
  },
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "axis": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontWeight": 500,
      "titleFontSize": 11,
      "domain": false,
      "ticks": false,
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "labelFontSize": 11
    }
  },
  "params": [
    {
      "name": "year",
      "value": 2026
    },
    {
      "name": "mode",
      "value": "all"
    },
    {
      "name": "sel",
      "value": "Northern Territory"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "a": -34,
            "b": 0,
            "z": "below"
          },
          {
            "a": 0,
            "b": 12,
            "z": "above"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "opacity": 0.07
      },
      "encoding": {
        "x": {
          "field": "a",
          "type": "quantitative",
          "scale": {
            "domain": [
              -34,
              12
            ],
            "nice": false
          },
          "axis": {
            "title": "Percentage points above or below the Australian result for the same test",
            "grid": true,
            "values": [
              -30,
              -20,
              -10,
              0,
              10
            ],
            "labelExpr": "(datum.value > 0 ? '+' : datum.value < 0 ? '−' : '') + abs(datum.value)"
          }
        },
        "x2": {
          "field": "b"
        },
        "fill": {
          "field": "z",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "below",
              "above"
            ],
            "range": [
              "#f0745a",
              "#1f6f8b"
            ]
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#14213d",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              -34,
              12
            ],
            "nice": false
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "i": -0.5,
            "i2": 0.5,
            "state": "Victoria"
          },
          {
            "i": 0.5,
            "i2": 1.5,
            "state": "Australian Capital Territory"
          },
          {
            "i": 1.5,
            "i2": 2.5,
            "state": "New South Wales"
          },
          {
            "i": 2.5,
            "i2": 3.5,
            "state": "Western Australia"
          },
          {
            "i": 3.5,
            "i2": 4.5,
            "state": "South Australia"
          },
          {
            "i": 4.5,
            "i2": 5.5,
            "state": "Queensland"
          },
          {
            "i": 5.5,
            "i2": 6.5,
            "state": "Tasmania"
          },
          {
            "i": 6.5,
            "i2": 7.5,
            "state": "Northern Territory"
          }
        ]
      },

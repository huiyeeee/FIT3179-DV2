{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waterfall chart for the selected state: start at the Australian result, add the effect of where the state's students live, then everything else, to reach the state's own result.",
  "width": "container",
  "height": 330,
  "padding": {
    "left": 4,
    "right": 12,
    "top": 20,
    "bottom": 4
  },
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "axis": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontWeight": 500,
      "titleFontSize": 11,
      "domain": false,
      "ticks": false,
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "labelFontSize": 11
    }
  },
  "params": [
    {
      "name": "year",
      "value": 2026
    },
    {
      "name": "sel",
      "value": "Northern Territory"
    }
  ],
  "data": {
    "url": "chapter-2/data/waterfall.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum.year == year && datum.state == sel"
    },
    {
      "calculate": "datum.step == 4 ? datum.state : datum.label",
      "as": "step_label"
    },
    {
      "calculate": "max(datum.start, datum.end)",
      "as": "top"
    },
    {
      "calculate": "datum.step == 1 ? '#9aa3b2' : datum.step == 2 ? '#b7791f' : datum.step == 3 ? '#8a96b0' : '#14213d'",
      "as": "bar_color"
    },
    {
      "calculate": "datum.kind == 'total' ? format(datum.value, '.1f') + '%' : (datum.value > 0 ? '+' : '−') + format(abs(datum.value), '.1f') + ' pp'",
      "as": "bar_text"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "start",
              "as": "nat"
            }
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#9aa3b2",
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "y": {
          "field": "nat",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              80
            ],
            "nice": false
          },
          "axis": null
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "cornerRadius": 3,
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "step_label",
          "type": "ordinal",
          "sort": {
            "field": "step",
            "op": "min"
          },
          "scale": {
            "padding": 0.25
          },
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 12,
            "labelFontWeight": 600,
            "labelColor": "#14213d",
            "labelLimit": 150,
            "labelPadding": 8,
            "labelExpr": "replace(replace(replace(datum.label, 'Where students live', 'Where its students\\nlive'), 'Everything else', 'Everything\\nelse'), 'Australian Capital Territory', 'ACT')"
          }
        },
        "y": {
          "field": "start",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              80
            ],
            "nice": false
          },
          "axis": {
            "title": "% meeting expectations",
            "grid": true,
            "values": [
              0,
              20,
              40,
              60,
              80
            ]
          }
        },
        "y2": {
          "field": "end"
        },
        "color": {
          "field": "bar_color",
          "type": "nominal",
          "scale": null,
          "legend": null
        },
        "tooltip": [
          {
            "field": "step_label",
            "title": "Step"
          },
          {
            "field": "bar_text",
            "title": "Value"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -9,
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#14213d"
      },
      "encoding": {
        "x": {
          "field": "step_label",
          "type": "ordinal",
          "sort": {
            "field": "step",
            "op": "min"
          },
          "scale": {
            "padding": 0.25
          },
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 12,
            "labelFontWeight": 600,
            "labelColor": "#14213d",
            "labelLimit": 150,
            "labelPadding": 8,
            "labelExpr": "replace(replace(replace(datum.label, 'Where students live', 'Where its students\\nlive'), 'Everything else', 'Everything\\nelse'), 'Australian Capital Territory', 'ACT')"
          }
        },
        "y": {
          "field": "top",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              80
            ],
            "nice": false
          },
          "axis": null
        },
        "text": {
          "field": "bar_text"
        }
      }
    }
  ]
}

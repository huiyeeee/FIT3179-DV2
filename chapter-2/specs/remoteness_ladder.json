            "labelColor": "#14213d",
            "labelFontWeight": 600,
            "labelPadding": 8,
            "labelExpr": "replace(datum.label, ' ', '\\n')"
          }
        },
        "y": {
          "field": "so",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              80
            ],
            "nice": false
          },
          "axis": {
            "title": "% meeting expectations",
            "grid": true,
            "values": [
              0,
              20,
              40,
              60,
              80
            ]
          }
        },
        "size": {
          "field": "n",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              5000000
            ],
            "range": [
              50,
              2400
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "remoteness",
            "title": "Type of area"
          },

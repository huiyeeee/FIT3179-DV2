{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map of Australian states and territories. Circle area = students tested; colour = how far the state is from the Australian figure (diverging classes).",
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 4,
    "right": 4,
    "top": 4,
    "bottom": 4
  },
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "axis": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontWeight": 500,
      "titleFontSize": 11,
      "domain": false,
      "ticks": false,
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "labelFontSize": 11
    }
  },
  "params": [
    {
      "name": "year",
      "value": 2026
    },
    {
      "name": "metric",
      "value": "so"
    },
    {
      "name": "sel",
      "value": "Northern Territory"
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "chapter-2/data/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ece8df",
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "url": "chapter-2/data/state_results.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.year == year && datum.state != 'Australia' && datum.leader == 1"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#9aa3b2",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "anchor_lon"
        },
        "latitude2": {
          "field": "anchor_lat"
        }
      }
    },
    {
      "data": {
        "url": "chapter-2/data/state_results.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.year == year && datum.state != 'Australia' && datum.reported == 1"
        },
        {
          "calculate": "metric == 'so' ? datum.band_so : datum.band_nas",
          "as": "band"
        },
        {
          "calculate": "metric == 'so' ? datum.gap_so : datum.gap_nas",
          "as": "gap"
        },
        {
          "calculate": "metric == 'so' ? datum.so : datum.nas",
          "as": "value"
        },
        {
          "calculate": "metric == 'so' ? datum.nat_so : datum.nat_nas",
          "as": "nat_value"
        },
        {
          "calculate": "(datum.gap > 0 ? '+' : datum.gap < 0 ? '−' : '') + format(abs(datum.gap), '.1f') + ' pp'",
          "as": "gap_label"
        },
        {
          "calculate": "format(datum.value, '.1f') + '%'",
          "as": "value_label"
        },
        {
          "calculate": "format(datum.nat_value, '.1f') + '%'",
          "as": "nat_label"
        },
        {
          "calculate": "indexof(['10+ pp worse', '3+ pp better'], datum.band) >= 0 ? '#ffffff' : '#14213d'",
          "as": "ink"
        },
        {
          "calculate": "format(datum.n, ',') + ' students tested'",
          "as": "n_label"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.95,
        "cursor": "pointer",
        "tooltip": true
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "n",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              2000000
            ],
            "range": [
              40,
              3600
            ]
          },
          "legend": {
            "title": "Students tested (area)",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "columnPadding": 16,
            "padding": 2,
            "values": [
              100000,
              500000,
              1000000,
              2000000
            ],
            "format": "~s",
            "symbolFillColor": "#c8c3b8",
            "symbolStrokeColor": "#9aa3b2",
            "symbolOpacity": 1
          }
        },
        "fill": {
          "field": "band",
          "type": "nominal",
          "scale": {
            "domain": [
              "10+ pp worse",
              "3-10 pp worse",
              "1-3 pp worse",
              "within 1 pp",
              "1-3 pp better",
              "3+ pp better"
            ],
            "range": [
              "#c2410c",
              "#f0745a",
              "#f8cbbd",
              "#ece8df",
              "#9fc9d8",
              "#0e5a78"
            ]
          },
          "legend": {
            "title": "Compared with Australia",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "columnPadding": 16,
            "padding": 2,
            "symbolType": "circle",
            "symbolSize": 160,
            "labelExpr": "replace(datum.label, '-', '–')"
          }
        },
        "stroke": {
          "condition": {
            "test": "datum.state == sel",
            "value": "#14213d"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.state == sel",
            "value": 3
          },
          "value": 1.5
        },
        "order": {
          "field": "n",
          "type": "quantitative",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "value_label",
            "title": "Result"
          },
          {
            "field": "nat_label",
            "title": "Australia"
          },
          {
            "field": "gap_label",
            "title": "Difference"
          },
          {
            "field": "n_label",
            "title": "Students"
          }
        ]
      }
    },
    {
      "data": {
        "url": "chapter-2/data/state_results.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.year == year && datum.state != 'Australia' && datum.reported == 0"
        },
        {
          "calculate": "format(datum.n, ',') + ' students sat the tests, but ACARA did not publish Tasmania’s 2026 results'",
          "as": "note"
        }
      ],
      "mark": {
        "type": "circle",
        "fill": "#ffffff",
        "fillOpacity": 0.7,
        "stroke": "#9aa3b2",
        "strokeDash": [
          4,
          3
        ],
        "strokeWidth": 1.5,
        "tooltip": true
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "n",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              2000000
            ],
            "range": [
              40,
              3600
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "note",
            "title": "Not published"
          }
        ]
      }
    },
    {
      "data": {
        "url": "chapter-2/data/state_results.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.year == year && datum.state != 'Australia' && datum.reported == 1 && datum.n >= 300000"
        },
        {
          "calculate": "metric == 'so' ? datum.band_so : datum.band_nas",
          "as": "band"
        },
        {
          "calculate": "metric == 'so' ? datum.gap_so : datum.gap_nas",
          "as": "gap"
        },
        {
          "calculate": "metric == 'so' ? datum.so : datum.nas",
          "as": "value"
        },
        {
          "calculate": "metric == 'so' ? datum.nat_so : datum.nat_nas",
          "as": "nat_value"
        },
        {
          "calculate": "(datum.gap > 0 ? '+' : datum.gap < 0 ? '−' : '') + format(abs(datum.gap), '.1f') + ' pp'",
          "as": "gap_label"
        },
        {
          "calculate": "format(datum.value, '.1f') + '%'",
          "as": "value_label"
        },
        {
          "calculate": "format(datum.nat_value, '.1f') + '%'",
          "as": "nat_label"
        },
        {
          "calculate": "indexof(['10+ pp worse', '3+ pp better'], datum.band) >= 0 ? '#ffffff' : '#14213d'",
          "as": "ink"
        },
        {
          "calculate": "format(datum.n, ',') + ' students tested'",
          "as": "n_label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -7,
        "fontSize": 11,
        "fontWeight": 700,
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "code"
        },
        "color": {
          "field": "ink",
          "type": "nominal",
          "scale": null,
          "legend": null
        }
      }
    },
    {
      "data": {
        "url": "chapter-2/data/state_results.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.year == year && datum.state != 'Australia' && datum.reported == 1 && datum.n >= 300000"
        },
        {
          "calculate": "metric == 'so' ? datum.band_so : datum.band_nas",
          "as": "band"
        },
        {
          "calculate": "metric == 'so' ? datum.gap_so : datum.gap_nas",
          "as": "gap"
        },
        {
          "calculate": "metric == 'so' ? datum.so : datum.nas",
          "as": "value"
        },
        {
          "calculate": "metric == 'so' ? datum.nat_so : datum.nat_nas",
          "as": "nat_value"
        },
        {
          "calculate": "(datum.gap > 0 ? '+' : datum.gap < 0 ? '−' : '') + format(abs(datum.gap), '.1f') + ' pp'",
          "as": "gap_label"
        },
        {
          "calculate": "format(datum.value, '.1f') + '%'",
          "as": "value_label"
        },
        {
          "calculate": "format(datum.nat_value, '.1f') + '%'",
          "as": "nat_label"
        },
        {
          "calculate": "indexof(['10+ pp worse', '3+ pp better'], datum.band) >= 0 ? '#ffffff' : '#14213d'",
          "as": "ink"
        },
        {
          "calculate": "format(datum.n, ',') + ' students tested'",
          "as": "n_label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": 8,
        "fontSize": 13,
        "fontWeight": 700
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "value_label"
        },
        "color": {
          "field": "ink",
          "type": "nominal",
          "scale": null,
          "legend": null
        }
      }
    },
    {
      "data": {
        "url": "chapter-2/data/state_results.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.year == year && datum.state != 'Australia' && datum.reported == 1 && datum.n < 300000"
        },
        {
          "calculate": "metric == 'so' ? datum.band_so : datum.band_nas",
          "as": "band"
        },
        {
          "calculate": "metric == 'so' ? datum.gap_so : datum.gap_nas",
          "as": "gap"
        },
        {
          "calculate": "metric == 'so' ? datum.so : datum.nas",
          "as": "value"
        },
        {
          "calculate": "metric == 'so' ? datum.nat_so : datum.nat_nas",
          "as": "nat_value"
        },
        {
          "calculate": "(datum.gap > 0 ? '+' : datum.gap < 0 ? '−' : '') + format(abs(datum.gap), '.1f') + ' pp'",
          "as": "gap_label"
        },
        {
          "calculate": "format(datum.value, '.1f') + '%'",
          "as": "value_label"
        },
        {
          "calculate": "format(datum.nat_value, '.1f') + '%'",
          "as": "nat_label"
        },
        {
          "calculate": "indexof(['10+ pp worse', '3+ pp better'], datum.band) >= 0 ? '#ffffff' : '#14213d'",
          "as": "ink"
        },
        {
          "calculate": "format(datum.n, ',') + ' students tested'",
          "as": "n_label"
        },
        {
          "calculate": "datum.code + ' ' + datum.value_label",
          "as": "small_label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": 17,
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#14213d"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "small_label"
        }
      }
    },
    {
      "data": {
        "url": "chapter-2/data/state_results.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.year == year && datum.state != 'Australia' && datum.reported == 0"
        },
        {
          "calculate": "datum.code + ' not published'",
          "as": "small_label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": 30,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#6b7280"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "small_label"
        }
      }
    },
    {
      "data": {
        "name": "annot"
      },
      "mark": {
        "type": "rule",
        "stroke": "#c2410c",
        "strokeWidth": 1.2,
        "strokeDash": [
          3,
          2
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon2",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat2",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon3"
        },
        "latitude2": {
          "field": "lat3"
        }
      }
    },
    {
      "data": {
        "name": "annot"
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12,
        "fontWeight": 600,
        "lineBreak": "\n",
        "lineHeight": 15,
        "color": "#c2410c"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ]
}

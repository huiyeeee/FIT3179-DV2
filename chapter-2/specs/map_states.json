        },
        {
          "filter": "datum.state == sel"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#14213d",
        "strokeWidth": 2.5
      }
    },
    {
      "data": {
        "url": "chapter-2/data/map_latest.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.leader == 1"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#9aa3b2",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "anchor_lon"
        },
        "latitude2": {
          "field": "anchor_lat"
        }
      }
    },
    {
      "data": {
        "url": "chapter-2/data/map_latest.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "n": "number",
            "so": "number",
            "nas": "number",
            "gap_so": "number",
            "gap_nas": "number",
            "nat_so": "number",
            "reported": "number",
            "lon": "number",
            "lat": "number",
            "anchor_lon": "number",
            "anchor_lat": "number",
            "leader": "number",
            "land_pct": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.leader == 1"
        },
        {
          "calculate": "datum.band_so",
          "as": "band"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 170,
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "cursor": "pointer",
        "tooltip": true
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "fill": {
          "field": "band",
          "type": "nominal",
          "scale": {
            "domain": [
              "10+ pp worse",
              "3-10 pp worse",
              "1-3 pp worse",
              "within 1 pp",
              "1-3 pp better",
              "3+ pp better",
              "Not published"
            ],
            "range": [
              "#c2410c",
              "#f0745a",
              "#f8cbbd",
              "#ece8df",
              "#9fc9d8",
              "#0e5a78",
              "#e3e3e3"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "so",
            "title": "Meeting expectations (%)",
            "format": ".1f"
          },
          {
            "field": "gap_so",
            "title": "Difference (points)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "chapter-2/data/map_latest.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "n": "number",
            "so": "number",
            "nas": "number",
            "gap_so": "number",
            "gap_nas": "number",
            "nat_so": "number",
            "reported": "number",
            "lon": "number",
            "lat": "number",
            "anchor_lon": "number",
            "anchor_lat": "number",
            "leader": "number",
            "land_pct": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.leader == 0"
        },
        {
          "calculate": "datum.reported == 1 ? datum.band_so : 'Not published'",

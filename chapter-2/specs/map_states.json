        },
        {
          "calculate": "indexof(['10+ pp worse', '3+ pp better'], datum.band) >= 0 ? '#ffffff' : '#14213d'",
          "as": "ink"
        },
        {
          "calculate": "datum.reported == 1 ? format(datum.so, '.1f') + '%' : 'not published'",
          "as": "value_label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -7,
        "fontSize": 11,
        "fontWeight": 700
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "code"
        },
        "color": {
          "field": "ink",
          "type": "nominal",
          "scale": null,
          "legend": null
        }
      }
    },
    {

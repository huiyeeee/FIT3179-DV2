{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map of Australian states and territories. Colour = how many percentage points the share of students meeting expectations is above or below Australia's. An inset marker shows the ACT; annotations are supplied by the page.",
  "width": "container",
  "height": "container",
  "padding": {
    "left": 0,
    "right": 0,
    "top": 0,
    "bottom": 0
  },
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "axis": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontWeight": 500,
      "titleFontSize": 11,
      "domain": false,
      "ticks": false,
      "gridColor": "#eee8dc"
    },
    "legend": {
      "labelFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "labelFontSize": 11
    }
  },
  "params": [
    {
      "name": "sel",
      "value": "Northern Territory"
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "parallels": [
      -18,
      -36
    ],
    "center": [
      0,
      -27
    ],
    "scale": {
      "expr": "width < 600 ? min(width * 1.05, height * 1.05) : min(width * 1.3, height * 1.3)"
    },
    "translate": {
      "expr": "[width / 2, height / 2]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "chapter-2/data/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "chapter-2/data/map_latest.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "year": "number",
                  "n": "number",
                  "so": "number",
                  "nas": "number",
                  "gap_so": "number",
                  "gap_nas": "number",
                  "nat_so": "number",
                  "reported": "number",
                  "lon": "number",
                  "lat": "number",
                  "anchor_lon": "number",
                  "anchor_lat": "number",
                  "leader": "number",
                  "land_pct": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "state",
              "code",
              "so",
              "gap_so",
              "band_so",
              "n",
              "nat_so",
              "reported",
              "lon",
              "lat",
              "land_pct"
            ]
          }
        },
        {
          "calculate": "datum.reported == 1 ? datum.band_so : 'Not published'",
          "as": "band"
        },
        {
          "calculate": "(datum.gap_so > 0 ? '+' : '−') + format(abs(datum.gap_so), '.1f') + ' points'",
          "as": "gap_label"
        },
        {
          "calculate": "datum.reported == 1 ? format(datum.so, '.1f') + '%' : 'not published'",
          "as": "value_label"
        },
        {
          "calculate": "format(datum.nat_so, '.1f') + '%'",
          "as": "nat_label"
        },
        {
          "calculate": "format(datum.n, ',') + ' students (' + format(datum.n / 6103856 * 100, '.1f') + '% of Australia)'",
          "as": "n_label"
        },
        {
          "calculate": "format(datum.land_pct, '.1f') + '% of Australia’s land'",
          "as": "land_label"
        },
        {
          "calculate": "indexof(['10+ pp worse', '3+ pp better'], datum.band) >= 0 ? '#ffffff' : '#14213d'",
          "as": "ink"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.4,
        "cursor": "pointer",
        "tooltip": true
      },
      "encoding": {
        "fill": {
          "field": "band",
          "type": "nominal",
          "scale": {
            "domain": [
              "10+ pp worse",
              "3-10 pp worse",
              "1-3 pp worse",
              "within 1 pp",
              "1-3 pp better",
              "3+ pp better",
              "Not published"
            ],
            "range": [
              "#c2410c",
              "#f0745a",
              "#f8cbbd",
              "#ece8df",
              "#9fc9d8",
              "#0e5a78",
              "#e3e3e3"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "value_label",
            "title": "Meeting expectations"
          },
          {
            "field": "nat_label",
            "title": "Australia"
          },
          {
            "field": "gap_label",
            "title": "Difference"
          },
          {
            "field": "n_label",
            "title": "Students tested"
          },
          {
            "field": "land_label",
            "title": "Area"
          }
        ]
      }
    },
    {
      "data": {
        "url": "chapter-2/data/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
